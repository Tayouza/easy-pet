{
  "name": "easypet-motion",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "remotion studio src/index.ts --port=3002",
    "render": "remotion render src/index.ts EasyPet out/easypet-apresentacao.mp4 --concurrency=2",
    "still": "remotion still src/index.ts EasyPet out/capa.png --frame=100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "render:vertical": "remotion render src/index.ts EasyPet-Vertical out/easypet-vertical.mp4 --concurrency=2 && npm run compat:vertical",
    "still:vertical": "remotion still src/index.ts EasyPet-Vertical out/capa-vertical.png --frame=60",
    "compat:vertical": "node scripts/export-mobile.mjs"
  },
  "dependencies": {
    "@remotion/cli": "latest",
    "remotion": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/nunito": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
